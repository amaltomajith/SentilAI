# Sentinel: copy to backend/.env (backend) and .env.local (frontend). NEVER commit real values.
# Everything below has a free tier. Nothing requires a payment method.

# ---- Backend (backend/.env) ----
DATABASE_URL=sqlite:///./data/sentinel.db
GROQ_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Shared HMAC secret between backend and whatsapp-bridge (>=32 random bytes, hex):  python -c "import secrets;print(secrets.token_hex(32))"
BRIDGE_SHARED_SECRET=
# Clerk "Frontend API URL" (Dashboard > API keys). The backend verifies session tokens against its public keys; no secret key is needed.
CLERK_ISSUER=
# Browser origins allowed to have issued a token (comma separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Local testing only: lets you sign in with any name instead of Clerk. Never set in production.
DEV_AUTH=0
MAX_LINKED_ACCOUNTS=5
MAX_TARGETS_PER_USER=3
# Public base URL used when minting canary links (e.g. a cloudflared quick-tunnel URL)
PUBLIC_BASE_URL=http://localhost:8000
TAKEDOWN_MODE=dry_run

# ---- Frontend (.env.local) ----
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
# Local testing only (pairs with DEV_AUTH=1 on the backend)
VITE_DEV_AUTH=0
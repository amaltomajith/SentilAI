# Sentinel deployment variables. Copy to .env (docker compose) or enter them in your host's dashboard. NEVER commit real values.
# Generate secrets:  python -c "import secrets;print(secrets.token_hex(32))"

# --- required ---
BRIDGE_SHARED_SECRET=            # >= 32 chars, used between the API and the WhatsApp connector
CLERK_ISSUER=                    # https://<instance>.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=        # origin(s) of the web app, e.g. https://sentinel.pages.dev
CORS_ORIGINS=                    # same origin(s)
PUBLIC_BASE_URL=                 # this server's public URL
GROQ_API_KEY=

# --- database: leave empty for SQLite on the volume (VM or home), or a Postgres URL (Supabase session pooler, port 5432) ---
DATABASE_URL=

# --- WhatsApp login storage ---
AUTH_STORE=file                  # file: credentials in the wa_session volume (VM, home).  db: encrypted in Postgres (Render and other hosts without a disk)
SESSION_ENC_KEY=                 # required when AUTH_STORE=db: 64 hex chars. Back it up: losing it logs everyone out of WhatsApp.

# --- optional ---
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
MAX_LINKED_ACCOUNTS=5
MAX_TARGETS_PER_USER=3
TRUSTED_PROXY=1                  # behind a tunnel or reverse proxy
TAKEDOWN_MODE=dry_run
BRIDGE_ENABLED=1                 # 0 runs the API only
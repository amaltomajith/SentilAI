# Sentinel WhatsApp Bridge. Copy to .env (git-ignored). The bridge refuses to start without the first two.
BACKEND_URL=http://localhost:8000
# Must equal BRIDGE_SHARED_SECRET in backend/.env (>= 32 chars). Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_SHARED_SECRET=
WA_SESSION_DIR=./wa_session
LOG_LEVEL=info
POLL_INTERVAL_MS=2000
# Set 0 to disable the typing indicator/delay before replies
HUMAN_DELAY=1